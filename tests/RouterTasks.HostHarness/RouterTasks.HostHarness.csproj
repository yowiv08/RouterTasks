<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RouterHostProject)" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>
  <Target Name="RequireHostProject" BeforeTargets="Restore;PrepareForBuild" Condition="'$(RouterHostProject)' == ''">
    <Error Text="指定 RouterHostProject 为隔离副本中的 Router.Host.csproj 路径。" />
  </Target>
</Project>
