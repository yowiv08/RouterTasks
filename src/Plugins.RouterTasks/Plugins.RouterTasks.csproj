<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Plugins.RouterTasks</RootNamespace>
    <AssemblyName>Plugins.RouterTasks</AssemblyName>
    <Version>0.3.2</Version>
    <Description>可配置 HTTP 排队、持续保活、自动重排、任务管理与 Telegram/Bark 通知。</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Router.Contracts" Version="2.0.0" />
    <EmbeddedResource Include="Web/*;Contracts/*.json" />
    <Content Include="Contracts/*NOTICE*;Contracts/*LICENSE*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="RouterTasks.Tests" />
  </ItemGroup>
</Project>
